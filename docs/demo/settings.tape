# Shared look for every recording. Sourced by the other tapes.
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 15
Set LineHeight 1.15
Set Width 1280
Set Padding 18
Set Margin 26
Set MarginFill "#1b2030"
Set WindowBar Colorful
Set WindowBarSize 34
Set BorderRadius 12
Set Framerate 24
Set TypingSpeed 55ms
Set Theme { "name": "QuestTUI", "black": "#0f1219", "red": "#e84838", "green": "#58c848", "yellow": "#f8d038", "blue": "#68a8f8", "magenta": "#b870e0", "cyan": "#68e0f0", "white": "#e8e4c8", "brightBlack": "#5a6478", "brightRed": "#ff6b5b", "brightGreen": "#7fdc6f", "brightYellow": "#ffe066", "brightBlue": "#8cc0ff", "brightMagenta": "#d29bf5", "brightCyan": "#8ff0fa", "brightWhite": "#ffffff", "background": "#0f1219", "foreground": "#e8e4c8", "selection": "#2a3040", "cursor": "#f8d038" }
Env XDG_CONFIG_HOME "/tmp/qt-vhs"
Env PS1 "$ "
Env COLORTERM "truecolor"
